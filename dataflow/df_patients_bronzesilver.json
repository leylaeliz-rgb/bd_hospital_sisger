{
	"name": "df_patients_bronzesilver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_sql_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_sql_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "normalizar"
				},
				{
					"name": "reglas"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(patient_id),",
				"          full_name = trim(regexReplace(replace(full_name,'Â',''), `^(Dr|Mr|Mrs|Ms|Miss)\\.?\\s+|\\s+(MD|DDS|DVM|PhD|Jr|Sr)\\.?$`, '')),",
				"          gender = case(in(['m','male'],lower(gender)),'Male', in(['f','female'],lower(gender)),'Female','Unknown'),",
				"          email = lower(replace(replace(replace(email,' at ','@'),'gmial','gmail'),',','.')),",
				"          phone = replace(replace(replace(replace(replace(replace(phone,'(',''),')',''),'-',''),'.',''),' ',''),'+',''),",
				"          insurance_provider = lower(replace(replace(replace(replace(insurance_provider,' ',''),'-',''),'.',''),'/','')),",
				"          date_of_birth = case(   isNull(date_of_birth), toDate(null()),   instr(date_of_birth,',')>0, toDate(date_of_birth,'MMMM dd, yyyy'),   instr(date_of_birth,'/')>0, toDate(date_of_birth,'MM/dd/yyyy'),   substring(date_of_birth,5,1)=='-', toDate(date_of_birth,'yyyy-MM-dd'),   length(date_of_birth)==8, toDate(concat(left(date_of_birth,6), iif(toInteger(right(date_of_birth,2))<=26,'20','19'), right(date_of_birth,2)), 'MM-dd-yyyy'),   length(date_of_birth)==11, toDate(date_of_birth,'dd-MMM-yyyy'),   toDate(null()))) ~> normalizar",
				"normalizar derive(phone = case(   length(phone)==10, concat(substring(phone,1,3),'-',substring(phone,4,3),'-',substring(phone,7,4)),   length(phone)==11 && left(phone,1)=='1', concat(substring(phone,2,3),'-',substring(phone,5,3),'-',substring(phone,8,4)),   toString(null())),",
				"          email = iif(instr(email,'@')>1 && instr(email,'.')>0, email, toString(null())),",
				"          insurance_provider = case(   isNull(insurance_provider),'Unknown',   instr(insurance_provider,'medicaid')>0,'Medicaid',   instr(insurance_provider,'medicare')>0,'Medicare',   instr(insurance_provider,'cigna')>0,'Cigna',   instr(insurance_provider,'united')>0 || insurance_provider=='uhc','UnitedHealthcare',   instr(insurance_provider,'blue')>0,'Blue Cross',   instr(insurance_provider,'aetna')>0,'Aetna',   instr(insurance_provider,'self')>0,'Self-Pay',   'Unknown'),",
				"          date_of_birth = iif(date_of_birth>currentDate() || date_of_birth<toDate('1900-01-01'), toDate(null()), date_of_birth)) ~> reglas",
				"reglas split(!isNull(patient_id) && !isNull(full_name),",
				"     disjoint: false) ~> split1@(valido, novalido)",
				"split1@valido aggregate(groupBy(patient_id),",
				"     full_name = first(full_name),",
				"          gender = first(gender),",
				"          date_of_birth = first(date_of_birth),",
				"          phone = first(phone),",
				"          email = first(email),",
				"          address = first(address),",
				"          insurance_provider = first(insurance_provider)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}