{
	"name": "df_admissions_bronzesilver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_sql_admissions",
						"type": "DatasetReference"
					},
					"name": "bronze"
				},
				{
					"dataset": {
						"referenceName": "silver_sql_patients",
						"type": "DatasetReference"
					},
					"name": "srcpacientesliver"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_sql_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "normalizar"
				},
				{
					"name": "reglas"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronze",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcpacientesliver",
				"bronze derive(patient_id = toInteger(patient_id),",
				"          admission_id = toInteger(admission_id),",
				"          attending_doctor_id = toInteger(attending_doctor_id),",
				"          department = lower(replace(department,' ','')),",
				"          admission_date = case(   isNull(admission_date), toDate(null()),   instr(admission_date,',')>0, toDate(admission_date,'MMMM dd, yyyy'),   instr(admission_date,'/')>0, toDate(admission_date,'MM/dd/yyyy'),   substring(admission_date,5,1)=='-', toDate(admission_date,'yyyy-MM-dd'),   length(admission_date)==8, toDate(concat(left(admission_date,6), iif(toInteger(right(admission_date,2))<=26,'20','19'), right(admission_date,2)), 'MM-dd-yyyy'),   length(admission_date)==11, toDate(admission_date,'dd-MMM-yyyy'),   toDate(null())),",
				"          discharge_date = case(   isNull(discharge_date), toDate(null()),   instr(discharge_date,',')>0, toDate(discharge_date,'MMMM dd, yyyy'),   instr(discharge_date,'/')>0, toDate(discharge_date,'MM/dd/yyyy'),   substring(discharge_date,5,1)=='-', toDate(discharge_date,'yyyy-MM-dd'),   length(discharge_date)==8, toDate(concat(left(discharge_date,6), iif(toInteger(right(discharge_date,2))<=26,'20','19'), right(discharge_date,2)), 'MM-dd-yyyy'),   length(discharge_date)==11, toDate(discharge_date,'dd-MMM-yyyy'),   toDate(null()))) ~> normalizar",
				"normalizar derive(department = case(   in(['cardiolgy','cardiology','cardio'],department),'Cardiology',   in(['oncology','oncologyy','onco'],department),'Oncology',   in(['emergency','emergancy','er'],department),'Emergency',   in(['pediatrics','paediatrics','peds'],department),'Pediatrics',   in(['neurology','nuerology','neuro'],department),'Neurology',   in(['orthopedics','orthopaedics','ortho'],department),'Orthopedics',   in(['generalsurgery','gensurg'],department),'General Surgery',   'Unknown'),",
				"          discharge_date = iif(!isNull(discharge_date) && !isNull(admission_date) \r",
				"&& discharge_date<admission_date, toDate(null()), discharge_date)) ~> reglas",
				"reglas split(!isNull(admission_id) && !isNull(patient_id) && !isNull(admission_date),",
				"     disjoint: false) ~> split1@(valido, novalido)",
				"exists1 aggregate(groupBy(admission_id),",
				"     patient_id = first(patient_id),",
				"          admission_date = first(admission_date),",
				"          department = first(department),",
				"          attending_doctor_id = first(attending_doctor_id)) ~> aggregate1",
				"split1@valido, srcpacientesliver exists(split1@valido@patient_id == srcpacientesliver@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}