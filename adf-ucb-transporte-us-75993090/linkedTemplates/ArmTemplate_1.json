		{
			"name": "[concat(parameters('factoryName'), '/df_gold_paciente')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "silver_sql_patients",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "gold_dim_paciente",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    t.patient_id AS patient_id_bk,\\n    t.full_name AS nombre_completo,\\n    CASE t.gender WHEN \\'Male\\' THEN \\'Masculino\\'\\n                  WHEN \\'Female\\' THEN \\'Femenino\\'\\n                  ELSE \\'Otro\\' END AS genero,\\n    t.date_of_birth AS fecha_nacimiento,\\n    CASE WHEN t.edad IS NULL THEN NULL\\n         WHEN t.edad <= 18 THEN \\'0-18\\'\\n         WHEN t.edad <= 35 THEN \\'19-35\\'\\n         WHEN t.edad <= 60 THEN \\'36-60\\'\\n         ELSE \\'60+\\' END AS rango_etario,\\n    t.email AS correo_electronico,\\n    t.address AS direccion,\\n    COALESCE(t.insurance_provider, \\'Unknown\\') AS proveedor_seguro\\nFROM (\\n    SELECT p.*,\\n           CASE WHEN p.date_of_birth IS NULL THEN NULL\\n                ELSE DATEDIFF(YEAR, p.date_of_birth, GETDATE())\\n                     - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.date_of_birth, GETDATE()), p.date_of_birth) > CAST(GETDATE() AS DATE)\\n                            THEN 1 ELSE 0 END\\n           END AS edad\\n    FROM silver.patients p\\n) t',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fecha')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "silver_sql_admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "gold_dim_fecha",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    CONVERT(INT, CONVERT(CHAR(8), f.fecha, 112)) AS fecha_key,\\n    f.fecha AS fecha_completa,\\n    YEAR(f.fecha) AS anio,\\n    DATEPART(QUARTER, f.fecha) AS trimestre,\\n    \\'T\\' + CAST(DATEPART(QUARTER, f.fecha) AS VARCHAR(1)) AS trimestre_nombre,\\n    MONTH(f.fecha) AS mes,\\n    CHOOSE(MONTH(f.fecha), \\'Enero\\',\\'Febrero\\',\\'Marzo\\',\\'Abril\\',\\'Mayo\\',\\'Junio\\',\\'Julio\\',\\'Agosto\\',\\'Septiembre\\',\\'Octubre\\',\\'Noviembre\\',\\'Diciembre\\') AS mes_nombre,\\n    CHOOSE(MONTH(f.fecha), \\'Ene\\',\\'Feb\\',\\'Mar\\',\\'Abr\\',\\'May\\',\\'Jun\\',\\'Jul\\',\\'Ago\\',\\'Sep\\',\\'Oct\\',\\'Nov\\',\\'Dic\\') AS mes_corto,\\n    DATEPART(ISO_WEEK, f.fecha) AS semana_anio,\\n    DAY(f.fecha) AS dia_mes,\\n    ds.dia_semana AS dia_semana,\\n    CHOOSE(ds.dia_semana, \\'Lunes\\',\\'Martes\\',\\'Miércoles\\',\\'Jueves\\',\\'Viernes\\',\\'Sábado\\',\\'Domingo\\') AS dia_nombre,\\n    CAST(CASE WHEN ds.dia_semana IN (6,7) THEN 1 ELSE 0 END AS BIT) AS es_fin_de_semana\\nFROM (\\n    SELECT admission_date AS fecha FROM silver.admissions\\n    UNION\\n    SELECT discharge_date FROM silver.admissions\\n    UNION\\n    SELECT payment_date FROM silver.billing\\n) f\\nCROSS APPLY (SELECT (DATEDIFF(DAY, \\'19000101\\', f.fecha) % 7) + 1 AS dia_semana) ds\\nWHERE f.fecha IS NOT NULL',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "silver_sql_admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "gold_fact_admisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    p.paciente_key,\\n    d.departamento_key,\\n    g.diagnostico_key,\\n    CONVERT(INT, CONVERT(CHAR(8), a.admission_date, 112)) AS fecha_ingreso_key,\\n    CASE WHEN a.discharge_date IS NULL THEN NULL\\n         ELSE CONVERT(INT, CONVERT(CHAR(8), a.discharge_date, 112)) END AS fecha_alta_key,\\n    a.attending_doctor_id AS medico_id,\\n    CASE WHEN a.discharge_date IS NULL THEN NULL\\n         ELSE DATEDIFF(DAY, a.admission_date, a.discharge_date) END AS dias_estancia\\nFROM silver.admissions a\\nJOIN gold.dim_paciente p\\n     ON p.patient_id_bk = a.patient_id\\nJOIN gold.dim_departamento d\\n     ON d.nombre_departamento = a.department\\nLEFT JOIN (\\n    SELECT admission_id, icd_code, severity,\\n           ROW_NUMBER() OVER (PARTITION BY admission_id ORDER BY diagnosis_id, icd_code) AS rn\\n    FROM silver.diagnoses\\n) dx ON dx.admission_id = a.admission_id AND dx.rn = 1\\nJOIN gold.dim_diagnostico g\\n     ON g.codigo_icd = COALESCE(dx.icd_code, \\'N/A\\')\\n    AND g.nivel_severidad = COALESCE(dx.severity, \\'Unknown\\')',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "silver_sql_biling",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "gold_fact_facturacion",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    p.paciente_key,\\n    d.departamento_key,\\n    s.servicio_cargo_key,\\n    CASE WHEN b.payment_date IS NULL THEN NULL\\n         ELSE CONVERT(INT, CONVERT(CHAR(8), b.payment_date, 112)) END AS fecha_pago_key,\\n    b.amount AS monto_facturado\\nFROM silver.billing b\\nJOIN silver.admissions a\\n     ON a.admission_id = b.admission_id\\nJOIN gold.dim_paciente p\\n     ON p.patient_id_bk = a.patient_id\\nJOIN gold.dim_departamento d\\n     ON d.nombre_departamento = a.department\\nJOIN gold.dim_servicio_cargo s\\n     ON s.tipo_cargo = b.charge_type\\n    AND s.estado_pago = b.payment_status',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
